# Aura Vega TV — Environment Configuration Template
NODE_ENV=development
APP_ID=com.auravega.tv
APP_NAME=Aura Vega TV
HOUSEHOLD_ID=household_ronak_jain_2025
ADMIN_PROFILE_ID=profile_ronak

# Runway ML Gen-4 Turbo Video AI
RUNWAYML_API_SECRET=your_runway_api_secret_here
RUNWAY_API_KEY=your_runway_api_secret_here

# Xano Cloud Backend & Database Platform
XANO_API_KEY=your_xano_api_key_here

# Higgsfield Kling AI Video & Motion Studio
HIGGSFIELD_API_KEY=your_key_id:your_key_secret
HF_API_KEY_ID=your_key_id
HF_API_KEY_SECRET=your_key_secret

# Supabase Cloud Sync & Real-Time Presence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Autonomous Engine Settings
ENABLE_AUTONOMOUS_HEADLESS_LOOP=true
ENABLE_GENERATIVE_MOTION=true
ENABLE_XANO_CLOUD_SYNC=true
ENABLE_SPLINE_SPATIAL_UI=true
AUTONOMOUS_SYNC_INTERVAL_MS=30000
